# ---------------------------------------------------------------------------
# trustwestme — copy to .env and fill in.  NEVER commit the real .env
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=8787
HOST=127.0.0.1
DB_PATH=./data/gateway.db
LOG_LEVEL=info

# --- Master seed -----------------------------------------------------------
# Generate with:  npm run seed
# This single phrase controls every user deposit address on every chain.
# Import it into the Trust Wallet app and you hold all customer funds.
MASTER_MNEMONIC=
MASTER_MNEMONIC_PASSPHRASE=

# Refuse to load the seed at all. The API can still hand out addresses that
# were generated earlier, but the process cannot derive or spend.
# Run your public-facing box like this once you are live.
WATCH_ONLY=false

# --- API credentials -------------------------------------------------------
# Generate with:  npm run keys
API_PUBLIC_KEY=
API_PRIVATE_KEY=

# auto       = accept any scheme below. Best for migrating off WestWallet.
# westwallet = X-API-KEY + X-ACCESS-SIGN + X-ACCESS-TIMESTAMP, what the
#              official WestWallet SDKs send. Signature is
#              hex(HMAC-SHA256(private key, timestamp + json body)).
# hmac       = X-API-KEY + X-Nonce + X-Signature over (nonce + public key).
# simple     = X-API-KEY + X-API-SECRET. Only acceptable behind TLS/localhost.
AUTH_MODE=auto
AUTH_NONCE_WINDOW_SEC=300

# Log what a rejected signature was computed over, so an existing integration
# can be matched exactly. Turn off once it works.
AUTH_DEBUG=false

# --- Deposit callbacks (IPN) ----------------------------------------------
# Your exchange's webhook. Used when a per-address ipn_url was not supplied.
DEFAULT_IPN_URL=
# Callbacks are signed: X-Gateway-Signature = HMAC-SHA256(IPN_SECRET, body)
IPN_SECRET=
IPN_TIMEOUT_MS=15000
IPN_MAX_ATTEMPTS=12

# --- Watcher ---------------------------------------------------------------
WATCHER_ENABLED=true
WATCHER_INTERVAL_MS=30000
# Comma-separated chain ids to scan. Empty means all of them.
# Useful for splitting chains across processes.
WATCHER_CHAINS=
REORG_DEPTH=50

# --- Tag / memo chain accounts --------------------------------------------
# XRP, XLM and EOS use ONE gateway account with a per-user tag or memo.
# Run `npm run addresses -- --shared` to see which accounts your seed produces,
# fund/register them, then paste the live values here.
XRP_ADDRESS=
STELLAR_ADDRESS=
EOS_ACCOUNT=

# --- Chain data sources ----------------------------------------------------
# Each accepts a COMMA-SEPARATED LIST, tried in order. Free endpoints rate
# limit, block, and go down; a second one keeps scanning alive.
BTC_BLOCKBOOK_URL=https://btc1.trezor.io,https://btc2.trezor.io
LTC_BLOCKBOOK_URL=https://ltc1.trezor.io,https://ltc2.trezor.io
DOGE_BLOCKBOOK_URL=https://doge1.trezor.io,https://doge2.trezor.io
DASH_BLOCKBOOK_URL=https://dash1.trezor.io,https://dash2.trezor.io
BCH_BLOCKBOOK_URL=https://bch1.trezor.io,https://bch2.trezor.io
ZEC_BLOCKBOOK_URL=https://zec1.trezor.io,https://zec2.trezor.io

ETH_RPC_URL=https://eth.llamarpc.com,https://rpc.ankr.com/eth,https://ethereum-rpc.publicnode.com
BSC_RPC_URL=https://bsc-dataseed.binance.org,https://bsc-dataseed1.defibit.io,https://bsc-rpc.publicnode.com

TRON_API_URL=https://api.trongrid.io
# Free key from trongrid.io. Without one Tron is capped at 2 requests a second,
# which is slow once you have more than a handful of addresses. Get one.
TRON_API_KEY=0b8d13ca-875e-475a-9db0-2092010134f0

# Requests per second per provider. Raise TRON_RPS once a key is set.
TRON_RPS=4
BLOCKBOOK_RPS=3
SOLANA_RPS=4

# How far behind the head the EVM scanner will start. Free RPCs refuse older
# blocks as "archive requests"; after a long outage the cursor jumps forward
# and the skipped range is logged rather than every request failing.
EVM_MAX_LOOKBACK_BLOCKS=5000

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
XRP_RPC_URL=https://xrplcluster.com
STELLAR_HORIZON_URL=https://horizon.stellar.org
EOS_API_URL=https://eos.greymass.com
TEZOS_API_URL=https://api.tzkt.io

# --- Telegram control bot --------------------------------------------------
# Uses long polling, so no public URL or webhook is needed.
#
#   1. Message @BotFather on Telegram, send /newbot, copy the token.
#   2. Send your new bot any message, then start the gateway — it replies with
#      your chat id if the chat is not yet authorized. Paste that below.
#
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
# The master chat: startup banner and deposit alerts land here.
TELEGRAM_CHAT_ID=
# Chats allowed to run commands (comma separated). Defaults to TELEGRAM_CHAT_ID.
# Anyone not listed is refused — without this, whoever finds your bot could
# read every balance in the exchange.
TELEGRAM_ADMIN_CHAT_IDS=
# Alert on first sight of a deposit, not only when it is credited.
TELEGRAM_NOTIFY_PENDING=true
# Post the command list to the master chat when the gateway starts.
TELEGRAM_ANNOUNCE_ON_START=true
TELEGRAM_API_URL=https://api.telegram.org

# --- Monero ----------------------------------------------------------------
# XMR is the one chain that needs its own daemon. See docs/OPERATIONS.md.
MONERO_WALLET_RPC_URL=http://127.0.0.1:18083
MONERO_WALLET_RPC_USER=
MONERO_WALLET_RPC_PASSWORD=
