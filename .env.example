# ---------------------------------------------------------------------------
# trustwestme — copy to .env and fill in.  NEVER commit the real .env
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=8080
HOST=0.0.0.0
DB_PATH=./data/gateway.db
LOG_LEVEL=info

# --- Master seed -----------------------------------------------------------
# Generate with:  npm run seed
# This single phrase controls every user deposit address on every chain.
# Import it into the Trust Wallet app and you hold all customer funds.
MASTER_MNEMONIC=
MASTER_MNEMONIC_PASSPHRASE=

# Refuse to load the seed at all. The API can still hand out addresses that
# were generated earlier, but the process cannot derive or spend.
# Run your public-facing box like this once you are live.
WATCH_ONLY=false

# --- API credentials -------------------------------------------------------
# Generate with:  npm run keys
API_PUBLIC_KEY=
API_PRIVATE_KEY=

# hmac   = signed requests (X-API-KEY + X-Nonce + X-Signature). Recommended.
# simple = X-API-KEY + X-API-SECRET. Only acceptable behind TLS.
AUTH_MODE=hmac
AUTH_NONCE_WINDOW_SEC=300

# --- Deposit callbacks (IPN) ----------------------------------------------
# Your exchange's webhook. Used when a per-address ipn_url was not supplied.
DEFAULT_IPN_URL=
# Callbacks are signed: X-Gateway-Signature = HMAC-SHA256(IPN_SECRET, body)
IPN_SECRET=
IPN_TIMEOUT_MS=15000
IPN_MAX_ATTEMPTS=12

# --- Watcher ---------------------------------------------------------------
WATCHER_ENABLED=true
WATCHER_INTERVAL_MS=30000
# Comma-separated chain ids to scan. Empty means all of them.
# Useful for splitting chains across processes.
WATCHER_CHAINS=
REORG_DEPTH=50

# --- Tag / memo chain accounts --------------------------------------------
# XRP, XLM and EOS use ONE gateway account with a per-user tag or memo.
# Run `npm run addresses -- --shared` to see which accounts your seed produces,
# fund/register them, then paste the live values here.
XRP_ADDRESS=
STELLAR_ADDRESS=
EOS_ACCOUNT=

# --- Chain data sources ----------------------------------------------------
# Every one of these has a working public default; override for reliability.
BTC_BLOCKBOOK_URL=https://btc1.trezor.io
LTC_BLOCKBOOK_URL=https://ltc1.trezor.io
DOGE_BLOCKBOOK_URL=https://doge1.trezor.io
DASH_BLOCKBOOK_URL=https://dash1.trezor.io
BCH_BLOCKBOOK_URL=https://bch1.trezor.io
ZEC_BLOCKBOOK_URL=https://zec1.trezor.io

ETH_RPC_URL=https://ethereum-rpc.publicnode.com
BSC_RPC_URL=https://bsc-rpc.publicnode.com

TRON_API_URL=https://api.trongrid.io
# Free key from trongrid.io — strongly recommended, the anonymous limit is low.
TRON_API_KEY=

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
XRP_RPC_URL=https://xrplcluster.com
STELLAR_HORIZON_URL=https://horizon.stellar.org
EOS_API_URL=https://eos.greymass.com
TEZOS_API_URL=https://api.tzkt.io

# --- Monero ----------------------------------------------------------------
# XMR is the one chain that needs its own daemon. See docs/OPERATIONS.md.
MONERO_WALLET_RPC_URL=http://127.0.0.1:18083
MONERO_WALLET_RPC_USER=
MONERO_WALLET_RPC_PASSWORD=
